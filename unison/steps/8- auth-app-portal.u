        ]
    ]

portal.auth.redirectGet : Text ->{Route} ()
portal.auth.redirectGet url =
  use Text ++
  fullUrl = portal.basePath ++ url
  setStatus (Status 303 "See Other")
  headers.add "Location" fullUrl
  headers.add "HX-Redirect" fullUrl

portal.auth.routes : '{Route, Exception, Remote, Random, Log, portal.Auth} ()
portal.auth.routes =
  use Optional None
  use Parser s
  use Route <|>
  use ok html
  use tapegram_html_2_0_0 toText
  use Text ++
  base = portal.basePath
  getLogin = do
    noCapture GET (s "login")
    content = [portal.topBar3 None, portal.loginForm2 "" None]
    html (portal.renderPage content)
  postLogin =
    do
      noCapture POST (s "login")
      formData = Route.request.getFormData()
      email = portal.getFormValue "email" formData
      password = portal.getFormValue "password" formData
      now = Remote.now()
      result = portal.Auth.handleLogin email password now
      match result with
        Left _ ->
          html (toText (portal.loginForm2 email (Some "Invalid email or password")))
        Right session ->
          portal.Auth.setSessionCookie session
          portal.auth.redirectGet "/"
  getRegister = do
    noCapture GET (s "register")
    content = [portal.topBar3 None, portal.registerForm2 "" None]
    html (portal.renderPage content)
  postRegister =
    do
      noCapture POST (s "register")
      formData = Route.request.getFormData()
      displayName = portal.getFormValue "displayName" formData
      email = portal.getFormValue "email" formData
      password = portal.getFormValue "password" formData
      now = Remote.now()
      result = portal.Auth.handleSignup displayName email password now
      match result with
        Left failure ->
          errorMsg =
            match failure with
              portal.Auth.SignupFailure.InvalidEmail ->
                "Please enter a valid email address"
              portal.Auth.SignupFailure.PasswordTooShort msg -> msg
              portal.Auth.SignupFailure.UserAlreadyExists ->
                "An account with this email already exists"
          html (toText (portal.registerForm2 displayName (Some errorMsg)))
        Right session ->
          portal.Auth.setSessionCookie session
          portal.auth.redirectGet "/"
  postLogout =
    do
      noCapture POST (s "logout")
      now = Remote.now()
      match portal.Auth.getSessionFromCookie now with
        Some session ->
          portal.Auth.deleteSession (portal.auth.Session.sessionId session)
        None -> ()
      portal.Auth.clearSessionCookie()
      headers.add "HX-Redirect" (base ++ "/")
      html (toText (tapegram_html_2_0_0.text ""))
  getLogin <|> postLogin <|> getRegister <|> postRegister <|> postLogout

ability portal.AppTileStorage where
  deleteTile : portal.AppTileId ->{portal.AppTileStorage} ()
  getTile : portal.AppTileId ->{portal.AppTileStorage} Optional portal.AppTile
  getTilesByUser :
    portal.auth.UserId ->{portal.AppTileStorage} [portal.AppTile]
  upsertTile : portal.AppTile ->{portal.AppTileStorage} ()

portal.AppTileStorage.run :
  Database -> '{g, portal.AppTileStorage} a ->{g, Remote} a
portal.AppTileStorage.run db p =
  use List :+
  use Optional getOrElse
  use OrderedTable named tryRead write
  use Text !=
  use Universal ordering
  tileTable = named db "portal_tiles" ordering
  userTilesIndex = named db "portal_tiles_by_user" ordering
  go : Request {portal.AppTileStorage} a ->{g, Remote} a
  go = cases
    { a } -> a
    { portal.AppTileStorage.getTile tid -> resume } ->
      result = tryRead tileTable (portal.AppTileId.toText tid)
      handle resume result with go
    { portal.AppTileStorage.getTilesByUser uid -> resume } ->
      uidText = portal.auth.UserId.toText uid
      tileIds = getOrElse [] (tryRead userTilesIndex uidText)
      tiles = List.filterMap (tid -> tryRead tileTable tid) tileIds
      sorted = sortBy portal.AppTile.portalTileOrder tiles
      handle resume sorted with go
    { portal.AppTileStorage.upsertTile tile -> resume } ->
      tid = portal.AppTileId.toText (portal.AppTile.portalTileId tile)
      uidText =
        portal.auth.UserId.toText (portal.AppTile.portalTileUserId tile)
      write tileTable tid tile
      existingIds = getOrElse [] (tryRead userTilesIndex uidText)
      newIds =
        if List.contains tid existingIds then existingIds
        else existingIds :+ tid
      write userTilesIndex uidText newIds
      handle resume() with go
    { portal.AppTileStorage.deleteTile tid -> resume } ->
      tidText = portal.AppTileId.toText tid
      maybeTile = tryRead tileTable tidText
      match maybeTile with
        Optional.None -> ()
        Some tile ->
          uidText =
            portal.auth.UserId.toText (portal.AppTile.portalTileUserId tile)
          existingIds = getOrElse [] (tryRead userTilesIndex uidText)
          newIds = List.filter (i -> i != tidText) existingIds
          write userTilesIndex uidText newIds
      OrderedTable.delete tileTable tidText
      handle resume() with go
  handle p() with go

type portal.AppTileId
  = AppTileId Text

type portal.AppTile
  = { portalTileId : portal.AppTileId,
      portalTileUserId : portal.auth.UserId,
      portalTileName : Text,
      portalTileImageUrl : Text,
      portalTileUrl : Text,
      portalTileOrder : Nat }

portal.AppTileId.toText : portal.AppTileId -> Text
portal.AppTileId.toText = cases portal.AppTileId.AppTileId id -> id

portal.app.routes :
  '{Route, Exception, portal.AppTileStorage, Remote, Random, Log, portal.Auth} ()
portal.app.routes =
  use Optional None
  use Parser / s
  use Route <|>
  use portal.AppTileId AppTileId
  use portal.AppTileStorage getTilesByUser
  use tapegram_html_2_0_0 toText text
  use Text ++
  base = portal.basePath
  emptyHtml = text ""
  homepage =
    do
      noCapture GET (s "")
      now = Remote.now()
      maybeUser = portal.Auth.getCurrentUser now
      tiles = match maybeUser with
        None      -> []
        Some user -> getTilesByUser (portal.auth.User.id user)
      isLoggedIn = isSome maybeUser
      topBarUser = Optional.map (u -> portal.auth.User.displayName u) maybeUser
      content =
        [ portal.topBar2 topBarUser
        , if isLoggedIn then portal.appGrid2 tiles true
          else tapegram_html_2_0_0.div [] portal.welcomeContent
        ]
      ok.html (portal.renderPage content)
  addAppModal = do
    noCapture GET (s "apps" / s "new")
    now = Remote.now()
    maybeUser = portal.Auth.getCurrentUser now
    match maybeUser with
      None   -> portal.auth.redirectGet "/login"
      Some _ -> ok.html (toText portal.addAppModalHtml2)
  createApp =
    do
      noCapture POST (s "apps")
      now = Remote.now()
      maybeUser = portal.Auth.getCurrentUser now
      match maybeUser with
        None -> portal.auth.redirectGet "/login"
        Some user ->
          formData = Route.request.getFormData()
          appName = portal.getFormValue "name" formData
          imgUrl = portal.getFormValue "imageUrl" formData
          appUrl = portal.getFormValue "url" formData
          existingTiles = getTilesByUser (portal.auth.User.id user)
          nextOrder = List.size existingTiles
          tileId = AppTileId (Bytes.toHex (Random.bytes 16))
          tile =
            portal.AppTile.AppTile
              tileId (portal.auth.User.id user) appName imgUrl appUrl nextOrder
          portal.AppTileStorage.upsertTile tile
          headers.add "HX-Redirect" (base ++ "/")
          ok.html (toText emptyHtml)
  deleteApp =
    do
      use Text ==
      appId = route DELETE (s "apps" / Parser.text)
      now = Remote.now()
      maybeUser = portal.Auth.getCurrentUser now
      match maybeUser with
        None -> portal.auth.redirectGet "/login"
        Some user ->
          maybeTile = portal.AppTileStorage.getTile (AppTileId appId)
          match maybeTile with
            None -> notFound.html "App not found"
            Some tile ->
              tileOwner =
                portal.auth.UserId.toText
                  (portal.AppTile.portalTileUserId tile)
              usrId = portal.auth.UserId.toText (portal.auth.User.id user)
              if tileOwner == usrId then
                portal.AppTileStorage.deleteTile (AppTileId appId)
                ok.html (toText emptyHtml)
              else forbidden.text "Not authorized"
  healthCheck = do
    noCapture GET (s "health")
    ok.json (Json.object [] |> addText "status" "ok")
  homepage <|> addAppModal <|> createApp <|> deleteApp <|> healthCheck

