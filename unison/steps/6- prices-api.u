stores.deployLocal : '{IO, Exception} URI
stores.deployLocal = main.local.serve do
  env = Environment.default()
  db = Database.named "stores-db"
  Database.assign db env
  hash = deployHttp env (stores.main db)
  name = ServiceName.named "stores-api"
  ServiceName.assign name hash

stores.main :
  Database -> HttpRequest ->{Exception, Storage, Remote, Log} HttpResponse
stores.main db req = StoreStorage.run db do Route.run stores.routes req

stores.routes : '{StoreStorage, Route, Exception, Log} ()
stores.routes =
  use Nat toText
  use Parser / nat
  use Route <|>
  use Store decoder toJson
  use StoreStorage get upsert
  use Text ++
  health = do
    noCapture GET (s "health")
    ok.text "ok"
  getAllStores = do
    noCapture GET (s "stores")
    info "Getting all stores" []
    stores = getAll()
    json = Json.array (List.map toJson stores)
    ok.json json
  getStoreById = do
    storeId = route GET (s "stores" / nat)
    info "Getting store" [("id", toText storeId)]
    match get (StoreId storeId) with
      Some store -> ok.json (toJson store)
      None       -> notFound.text ("Store not found: " ++ toText storeId)
  createStore = do
    noCapture POST (s "stores")
    store = decodeJson decoder
    info "Creating store" [("id", toText (Store.id store))]
    upsert store
    setStatus (Status 201 "Created")
    ok.json (toJson store)
  updateStore =
    do
      storeId = route PUT (s "stores" / nat)
      store = decodeJson decoder
      info "Updating store" [("id", toText storeId)]
      match get (StoreId storeId) with
        Some _ ->
          updatedStore =
            Store
              storeId
              (Store.key store)
              (Store.name store)
              (lon store)
              (lat store)
              (address store)
              (postalCode store)
              (city store)
              (imageUrl store)
          upsert updatedStore
          ok.json (toJson updatedStore)
        None -> notFound.text ("Store not found: " ++ toText storeId)
  deleteStore = do
    storeId = route DELETE (s "stores" / nat)
    info "Deleting store" [("id", toText storeId)]
    match get (StoreId storeId) with
      Some _ ->
        StoreStorage.delete (StoreId storeId)
        ok.text "Deleted"
      None   -> notFound.text ("Store not found: " ++ toText storeId)
  health
    <|> getStoreById
    <|> getAllStores
    <|> createStore
    <|> updateStore
    <|> deleteStore

StoreStorage.run : Database -> '{g, StoreStorage} a ->{g, Remote} a
StoreStorage.run db computation =
  table : OrderedTable Nat Store
  table = OrderedTable.named db "stores" Universal.ordering
  go : Request {StoreStorage} a ->{g, Remote} a
  go = cases
    { a }                                               -> a
    { StoreStorage.get (StoreId storeId) -> resume }    ->
      result = OrderedTable.tryRead table storeId
      handle resume result with go
    { StoreStorage.upsert store -> resume }             ->
      OrderedTable.write table (Store.id store) store
      handle resume() with go
    { StoreStorage.delete (StoreId storeId) -> resume } ->
      OrderedTable.delete table storeId
      handle resume() with go
    { getAll () -> resume }                             ->
      stores = Stream.toList (OrderedTable.toStream table) |> List.map at2
      handle resume stores with go
  handle computation() with go

