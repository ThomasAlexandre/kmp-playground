type StoreId
  = StoreId Nat

type ProductIdentifier
  = StoreSpecific StoreId Text
  | UniversalBarcode Text

type PriceUnit
  = PerItem
  | PerKg
  | Per100g
  | PerLiter

type PriceRecord
  = { priceValue : Text, currency : Text, unit : PriceUnit }

farFuture : Instant
farFuture = fromEpochSeconds +253402300800

PriceUnit.toText : PriceUnit -> Text
PriceUnit.toText = cases
  PriceUnit.PerItem  -> "per_item"
  PriceUnit.PerKg    -> "per_kg"
  PriceUnit.Per100g  -> "per_100g"
  PriceUnit.PerLiter -> "per_liter"

PriceUnit.fromText : Text -> Optional PriceUnit
PriceUnit.fromText = cases
  "per_item"  -> Some PriceUnit.PerItem
  "per_kg"    -> Some PriceUnit.PerKg
  "per_100g"  -> Some PriceUnit.Per100g
  "per_liter" -> Some PriceUnit.PerLiter
  _           -> None

PriceUnit.decoder : '{Decoder} PriceUnit
PriceUnit.decoder = do
  use Text ++
  txt = Decoder.text()
  match PriceUnit.fromText txt with
    Some u -> u
    None   -> Decoder.fail ("Invalid price unit: " ++ txt)

ProductIdentifier.toJson : ProductIdentifier -> Json
ProductIdentifier.toJson = cases
  ProductIdentifier.UniversalBarcode code ->
    Json.object [("type", Json.text "barcode"), ("code", Json.text code)]
  ProductIdentifier.StoreSpecific (StoreId.StoreId sid) code ->
    Json.object
      [ ("type", Json.text "store_specific")
      , ("storeId", Json.text (Nat.toText sid))
      , ("code", Json.text code)
      ]

ProductIdentifier.decoder : '{Decoder} ProductIdentifier
ProductIdentifier.decoder =
  do
    use Decoder text
    use Text ++
    use object at!
    idType = at! "type" text
    code = at! "code" text
    match idType with
      "barcode" -> ProductIdentifier.UniversalBarcode code
      "store_specific" ->
        sidText = at! "storeId" text
        sid = match Nat.fromText sidText with
          Some n -> n
          None -> Decoder.fail ("Invalid storeId, expected number: " ++ sidText)
        ProductIdentifier.StoreSpecific (StoreId.StoreId sid) code
      _ -> Decoder.fail ("Invalid product identifier type: " ++ idType)

PriceRecord.toJson : PriceRecord -> Json
PriceRecord.toJson record =
  use Json text
  Json.object
    [ ("price", text (PriceRecord.priceValue record))
    , ("currency", text (PriceRecord.currency record))
    , ("unit", text (PriceUnit.toText (PriceRecord.unit record)))
    ]

PriceRecord.decoder : '{Decoder} PriceRecord
PriceRecord.decoder = do
  use Decoder text
  use object at!
  priceValue = at! "price" text
  currency = at! "currency" text
  unit = at! "unit" PriceUnit.decoder
  PriceRecord.PriceRecord priceValue currency unit

type RecordPriceRequest
  = { product : ProductIdentifier, storeId : Nat, priceRecord : PriceRecord }

RecordPriceRequest.decoder : '{Decoder} RecordPriceRequest
RecordPriceRequest.decoder = do
  use object at!
  use Text ++
  product = at! "product" ProductIdentifier.decoder
  storeIdText = at! "storeId" Decoder.text
  storeId = match Nat.fromText storeIdText with
    Some n -> n
    None -> Decoder.fail ("Invalid storeId, expected number: " ++ storeIdText)
  priceRecord = at! "price" PriceRecord.decoder
  RecordPriceRequest.RecordPriceRequest product storeId priceRecord

structural ability PriceStorage where
  getLatestPrice :
    ProductIdentifier
    -> StoreId
    ->{PriceStorage} Optional (Instant, PriceRecord)
  getPricesAcrossStores :
    ProductIdentifier ->{PriceStorage} [(StoreId, Instant, PriceRecord)]
  getPriceHistory :
    ProductIdentifier -> StoreId ->{PriceStorage} [(Instant, PriceRecord)]
  getLatestPricesAtStore :
    StoreId ->{PriceStorage} [(ProductIdentifier, Instant, PriceRecord)]
  recordPrice : ProductIdentifier -> StoreId -> PriceRecord ->{PriceStorage} ()

PriceStorage.run : Database -> '{g, PriceStorage} a ->{g, Remote} a
PriceStorage.run db computation =
  use OrderedTable named rangeClosed write
  use ProductIdentifier UniversalBarcode
  use StoreId StoreId
  use Stream toList
  use Universal ordering
  productIndex = named db "prices_by_product" ordering
  storeIndex = named db "prices_by_store" ordering
  go : Request {PriceStorage} a ->{g, Remote} a
  go = cases
    { a }                                                           -> a
    { PriceStorage.recordPrice productId storeId record -> resume } ->
      now = Remote.now()
      primaryKey = (productId, storeId, now)
      secondaryKey = (storeId, productId, now)
      write productIndex primaryKey record
      write storeIndex secondaryKey record
      handle resume() with go
    { PriceStorage.getLatestPrice productId storeId -> resume }     ->
      startKey = (productId, storeId, epoch)
      endKey = (productId, storeId, farFuture)
      entries = toList (rangeClosed productIndex startKey endKey)
      result = match List.last entries with
        None                           -> None
        Some ((_, _, instant), record) -> Some (instant, record)
      handle resume result with go
    { PriceStorage.getPriceHistory productId storeId -> resume }    ->
      startKey = (productId, storeId, epoch)
      endKey = (productId, storeId, farFuture)
      entries = toList (rangeClosed productIndex startKey endKey)
      extractEntry = cases ((_, _, instant), record) -> (instant, record)
      history = List.reverse (List.map extractEntry entries)
      handle resume history with go
    { PriceStorage.getPricesAcrossStores productId -> resume }      ->
      startKey = (productId, StoreId 0, epoch)
      endKey = (productId, StoreId Nat.maxNat, farFuture)
      allEntries = toList (rangeClosed productIndex startKey endKey)
      latestByStore = groupLatestByStore allEntries
      handle resume latestByStore with go
    { PriceStorage.getLatestPricesAtStore storeId -> resume }       ->
      startKey = (storeId, UniversalBarcode "", epoch)
      endKey = (storeId, UniversalBarcode "~", farFuture)
      allEntries = toList (rangeClosed storeIndex startKey endKey)
      latestByProduct = groupLatestByProduct allEntries
      handle resume latestByProduct with go
  handle computation() with go

groupLatestByStore :
  [((ProductIdentifier, StoreId, Instant), PriceRecord)]
  -> [(StoreId, Instant, PriceRecord)]
groupLatestByStore entries =
  use Instant >
  use Map insert
  go acc = cases
    [] ->
      Map.toList acc
        |> (List.map cases
          (storeId, (instant, record)) -> (storeId, instant, record))
    ((_, storeId, instant), record) +: rest ->
      updated =
        match Map.get storeId acc with
          None -> insert storeId (instant, record) acc
          Some (existingInstant, _) ->
            if instant > existingInstant then
              insert storeId (instant, record) acc
            else acc
      go updated rest
  go Map.empty entries

groupLatestByProduct :
  [((StoreId, ProductIdentifier, Instant), PriceRecord)]
  -> [(ProductIdentifier, Instant, PriceRecord)]
groupLatestByProduct entries =
  use Instant >
  use Map insert
  go acc = cases
    [] ->
      Map.toList acc
        |> (List.map cases
          (productId, (instant, record)) -> (productId, instant, record))
    ((_, productId, instant), record) +: rest ->
      updated =
        match Map.get productId acc with
          None -> insert productId (instant, record) acc
          Some (existingInstant, _) ->
            if instant > existingInstant then
              insert productId (instant, record) acc
            else acc
      go updated rest
  go Map.empty entries

parseStoreId : Text -> Optional StoreId
parseStoreId txt = match Nat.fromText txt with
  Some n -> Some (StoreId n)
  None -> None

prices.routes : '{Route, Exception, Log, PriceStorage} ()
prices.routes =
  use Instant toText
  use Json array object
  use List head map
  use Parser /
  use ProductIdentifier UniversalBarcode
  use Route <|>
  health = do
    noCapture GET (s "health")
    ok.text "ok"
  createPrice =
    do
      noCapture POST (s "prices")
      request = decodeJson RecordPriceRequest.decoder
      info "Recording price" [("storeId", Nat.toText (RecordPriceRequest.storeId request))]
      PriceStorage.recordPrice
        (RecordPriceRequest.product request)
        (StoreId (RecordPriceRequest.storeId request))
        (RecordPriceRequest.priceRecord request)
      setStatus (Status 201 "Created")
      ok.json (object [("status", Json.text "created")])
  getLatestPriceBarcode =
    do
      code = route GET (s "prices" / s "barcode" / Parser.text)
      storeIds = queryParameter "storeId"
      match head storeIds with
        None -> badRequest.text "Missing storeId query parameter"
        Some storeIdText ->
          match parseStoreId storeIdText with
            None -> badRequest.text "Invalid storeId, expected number"
            Some storeId ->
              match PriceStorage.getLatestPrice (UniversalBarcode code) storeId with
                None -> notFound.text "Price not found"
                Some (instant, record) ->
                  json =
                    object
                      [ ("recordedAt", Json.text (toText instant))
                      , ("price", PriceRecord.toJson record)
                      ]
                  ok.json json
  getPriceHistoryBarcode =
    do
      code = route GET (s "prices" / s "barcode" / Parser.text / s "history")
      storeIds = queryParameter "storeId"
      match head storeIds with
        None -> badRequest.text "Missing storeId query parameter"
        Some storeIdText ->
          match parseStoreId storeIdText with
            None -> badRequest.text "Invalid storeId, expected number"
            Some storeId ->
              history = PriceStorage.getPriceHistory (UniversalBarcode code) storeId
              entryToJson = cases
                (instant, record) ->
                  object
                    [ ("recordedAt", Json.text (toText instant))
                    , ("price", PriceRecord.toJson record)
                    ]
              ok.json (array (map entryToJson history))
  comparePricesBarcode =
    do
      code = route GET (s "prices" / s "barcode" / Parser.text / s "compare")
      prices = PriceStorage.getPricesAcrossStores (UniversalBarcode code)
      entryToJson = cases
        (StoreId sid, instant, record) ->
          object
            [ ("storeId", Json.text (Nat.toText sid))
            , ("recordedAt", Json.text (toText instant))
            , ("price", PriceRecord.toJson record)
            ]
      ok.json (array (map entryToJson prices))
  getStorePricesRoute =
    do
      storeIdText = route GET (s "stores" / Parser.text / s "prices")
      match parseStoreId storeIdText with
        None -> badRequest.text "Invalid storeId, expected number"
        Some storeId ->
          prices = PriceStorage.getLatestPricesAtStore storeId
          entryToJson = cases
            (productId, instant, record) ->
              object
                [ ("product", ProductIdentifier.toJson productId)
                , ("recordedAt", Json.text (toText instant))
                , ("price", PriceRecord.toJson record)
                ]
          ok.json (array (map entryToJson prices))
  health
    <|> createPrice
    <|> getLatestPriceBarcode
    <|> getPriceHistoryBarcode
    <|> comparePricesBarcode
    <|> getStorePricesRoute

prices.main :
  Database -> HttpRequest ->{Exception, Storage, Remote, Log} HttpResponse
prices.main db req = PriceStorage.run db do Route.run prices.routes req

addCorsHeaders : HttpResponse -> HttpResponse
addCorsHeaders response =
  use HttpResponse addHeader
  response
    |> addHeader "Access-Control-Allow-Origin" "*"
    |> addHeader
         "Access-Control-Allow-Methods" "GET, POST, PUT, DELETE, OPTIONS"
    |> addHeader "Access-Control-Allow-Headers" "Content-Type, Authorization"

isOptionsMethod : HttpRequest -> Boolean
isOptionsMethod req = match HttpRequest.method req with
  OPTIONS -> true
  _       -> false

prices.mainWithCors :
  Database -> HttpRequest ->{Exception, Storage, Remote, Log} HttpResponse
prices.mainWithCors db req =
  if isOptionsMethod req then
    addCorsHeaders (unison_http_14_0_0.HttpResponse.ok Body.empty)
  else addCorsHeaders (prices.main db req)

prices.deployLocal : '{IO, Exception} URI
prices.deployLocal = main.local.serve do
  env = Environment.default()
  db = Database.named "prices-db"
  Database.assign db env
  hash = deployHttp env (prices.mainWithCors db)
  name = ServiceName.named "prices-api"
  ServiceName.assign name hash

prices.deployCloud : '{IO, Exception} ServiceHash HttpRequest HttpResponse
prices.deployCloud = Cloud.main do
  env = Environment.default()
  db = Database.named "prices-db"
  Database.assign db env
  hash = deployHttp env (prices.mainWithCors db)
  name = ServiceName.named "prices-api"
  _ = ServiceName.assign name hash
  hash

