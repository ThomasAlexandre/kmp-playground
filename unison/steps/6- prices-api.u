---- Anything below this line is ignored by Unison.


use lib.unison_cloud_27_2_0
use lib.unison_cloud_27_2_0.lib.unison_http_14_0_0
use lib.unison_routes_7_0_2
use lib.unison_json_1_3_5

-- ============================================================================
-- Price Storage API
-- Dual-indexed storage for product prices with cross-store comparison
-- ============================================================================

-- ============================================================
-- Types
-- ============================================================

unique type StoreId = StoreId Nat

unique type ProductIdentifier
  = UniversalBarcode Text
  | StoreSpecific StoreId Text

unique type PriceUnit
  = PerItem
  | PerKg
  | Per100g
  | PerLiter

unique type PriceRecord = {
  priceValue : Text,
  currency : Text,
  unit : PriceUnit
}

-- Far-future instant for range queries (year 9999)
farFuture : Instant
farFuture = Instant.fromEpochSeconds +253402300800

-- ============================================================
-- JSON Encoding/Decoding
-- ============================================================

PriceUnit.toText : PriceUnit -> Text
PriceUnit.toText = cases
  PerItem -> "per_item"
  PerKg -> "per_kg"
  Per100g -> "per_100g"
  PerLiter -> "per_liter"

PriceUnit.fromText : Text -> Optional PriceUnit
PriceUnit.fromText = cases
  "per_item" -> Some PerItem
  "per_kg" -> Some PerKg
  "per_100g" -> Some Per100g
  "per_liter" -> Some PerLiter
  _ -> None

PriceUnit.decoder : '{Decoder} PriceUnit
PriceUnit.decoder = do
  txt = !Decoder.text
  match PriceUnit.fromText txt with
    Some u -> u
    None -> Decoder.fail ("Invalid price unit: " Text.++ txt)

ProductIdentifier.toJson : ProductIdentifier -> Json
ProductIdentifier.toJson = cases
  UniversalBarcode code ->
    Json.object [("type", Json.text "barcode"), ("code", Json.text code)]
  StoreSpecific (StoreId sid) code ->
    Json.object [("type", Json.text "store_specific"), ("storeId", Json.text (Nat.toText sid)), ("code", Json.text code)]

ProductIdentifier.decoder : '{Decoder} ProductIdentifier
ProductIdentifier.decoder = do
  use Decoder.object at!
  idType = at! "type" Decoder.text
  code = at! "code" Decoder.text
  match idType with
    "barcode" -> UniversalBarcode code
    "store_specific" ->
      sidText = at! "storeId" Decoder.text
      sid = match Nat.fromText sidText with
        Some n -> n
        None -> Decoder.fail ("Invalid storeId, expected number: " Text.++ sidText)
      StoreSpecific (StoreId sid) code
    _ -> Decoder.fail ("Invalid product identifier type: " Text.++ idType)

PriceRecord.toJson : PriceRecord -> Json
PriceRecord.toJson record =
  Json.object [("price", Json.text (PriceRecord.priceValue record)), ("currency", Json.text (PriceRecord.currency record)), ("unit", Json.text (PriceUnit.toText (PriceRecord.unit record)))]

PriceRecord.decoder : '{Decoder} PriceRecord
PriceRecord.decoder = do
  use Decoder.object at!
  priceValue = at! "price" Decoder.text
  currency = at! "currency" Decoder.text
  unit = at! "unit" PriceUnit.decoder
  PriceRecord priceValue currency unit

-- Request/Response types
unique type RecordPriceRequest = {
  product : ProductIdentifier,
  storeId : Nat,
  priceRecord : PriceRecord
}

RecordPriceRequest.decoder : '{Decoder} RecordPriceRequest
RecordPriceRequest.decoder = do
  use Decoder.object at!
  product = at! "product" ProductIdentifier.decoder
  storeIdText = at! "storeId" Decoder.text
  storeId = match Nat.fromText storeIdText with
    Some n -> n
    None -> Decoder.fail ("Invalid storeId, expected number: " Text.++ storeIdText)
  priceRecord = at! "price" PriceRecord.decoder
  RecordPriceRequest product storeId priceRecord

-- ============================================================
-- Storage Ability
-- ============================================================

structural ability PriceStorage where
  recordPrice : ProductIdentifier -> StoreId -> PriceRecord ->{PriceStorage} ()
  getLatestPrice : ProductIdentifier -> StoreId ->{PriceStorage} Optional (Instant, PriceRecord)
  getPriceHistory : ProductIdentifier -> StoreId ->{PriceStorage} [(Instant, PriceRecord)]
  getPricesAcrossStores : ProductIdentifier ->{PriceStorage} [(StoreId, Instant, PriceRecord)]
  getLatestPricesAtStore : StoreId ->{PriceStorage} [(ProductIdentifier, Instant, PriceRecord)]

-- ============================================================
-- Handler Implementation with Dual Index
-- ============================================================

PriceStorage.run : Database -> '{g, PriceStorage} a ->{g, Remote} a
PriceStorage.run db computation =
  productIndex = OrderedTable.named db "prices_by_product" Universal.ordering
  storeIndex = OrderedTable.named db "prices_by_store" Universal.ordering

  go : Request {PriceStorage} a ->{g, Remote} a
  go = cases
    { a } -> a

    { PriceStorage.recordPrice productId storeId record -> resume } ->
      now = Remote.now ()
      primaryKey = (productId, storeId, now)
      secondaryKey = (storeId, productId, now)
      OrderedTable.write productIndex primaryKey record
      OrderedTable.write storeIndex secondaryKey record
      handle resume () with go

    { PriceStorage.getLatestPrice productId storeId -> resume } ->
      startKey = (productId, storeId, Instant.epoch)
      endKey = (productId, storeId, farFuture)
      entries = Stream.toList (OrderedTable.rangeClosed productIndex startKey endKey)
      result = match List.last entries with
        None -> None
        Some ((_, _, instant), record) -> Some (instant, record)
      handle resume result with go

    { PriceStorage.getPriceHistory productId storeId -> resume } ->
      startKey = (productId, storeId, Instant.epoch)
      endKey = (productId, storeId, farFuture)
      entries = Stream.toList (OrderedTable.rangeClosed productIndex startKey endKey)
      extractEntry = cases ((_, _, instant), record) -> (instant, record)
      history = List.reverse (List.map extractEntry entries)
      handle resume history with go

    { PriceStorage.getPricesAcrossStores productId -> resume } ->
      startKey = (productId, StoreId 0, Instant.epoch)
      endKey = (productId, StoreId Nat.maxNat, farFuture)
      allEntries = Stream.toList (OrderedTable.rangeClosed productIndex startKey endKey)
      latestByStore = groupLatestByStore allEntries
      handle resume latestByStore with go

    { PriceStorage.getLatestPricesAtStore storeId -> resume } ->
      startKey = (storeId, UniversalBarcode "", Instant.epoch)
      endKey = (storeId, UniversalBarcode "~", farFuture)
      allEntries = Stream.toList (OrderedTable.rangeClosed storeIndex startKey endKey)
      latestByProduct = groupLatestByProduct allEntries
      handle resume latestByProduct with go

  handle computation() with go

-- ============================================================
-- Helper Functions
-- ============================================================

groupLatestByStore : [((ProductIdentifier, StoreId, Instant), PriceRecord)] -> [(StoreId, Instant, PriceRecord)]
groupLatestByStore entries =
  go acc rem = match rem with
    [] ->
      Map.toList acc
        |> List.map (cases (storeId, (instant, record)) -> (storeId, instant, record))
    ((_, storeId, instant), record) +: rest ->
      updated = match Map.get storeId acc with
        None -> Map.insert storeId (instant, record) acc
        Some (existingInstant, _) ->
          if instant Instant.> existingInstant
          then Map.insert storeId (instant, record) acc
          else acc
      go updated rest
  go Map.empty entries

groupLatestByProduct : [((StoreId, ProductIdentifier, Instant), PriceRecord)] -> [(ProductIdentifier, Instant, PriceRecord)]
groupLatestByProduct entries =
  go acc rem = match rem with
    [] ->
      Map.toList acc
        |> List.map (cases (productId, (instant, record)) -> (productId, instant, record))
    ((_, productId, instant), record) +: rest ->
      updated = match Map.get productId acc with
        None -> Map.insert productId (instant, record) acc
        Some (existingInstant, _) ->
          if instant Instant.> existingInstant
          then Map.insert productId (instant, record) acc
          else acc
      go updated rest
  go Map.empty entries

-- ============================================================
-- HTTP Routes
-- ============================================================

prices.routes : '{Route, Exception, PriceStorage, Log} ()
prices.routes =
  use Parser /
  use Text ++
  use Route <|>

  health = do
    noCapture GET (s "health")
    ok.text "ok"

  -- POST /prices - Record a new price
  createPrice = do
    noCapture POST (s "prices")
    request = decodeJson RecordPriceRequest.decoder
    info "Recording price" [("storeId", Nat.toText (RecordPriceRequest.storeId request))]
    PriceStorage.recordPrice
      (RecordPriceRequest.product request)
      (StoreId (RecordPriceRequest.storeId request))
      (RecordPriceRequest.priceRecord request)
    setStatus (Status 201 "Created")
    ok.json (Json.object [("status", Json.text "created")])

  -- GET /prices/barcode/<code>?storeId=X - Get latest price for barcode
  getLatestPriceBarcode = do
    code = route GET (s "prices" / s "barcode" / Parser.text)
    storeIds = Route.request.queryParameter "storeId"
    match List.head storeIds with
      None -> badRequest.text "Missing storeId query parameter"
      Some storeIdText ->
        match Nat.fromText storeIdText with
          None -> badRequest.text "Invalid storeId, expected number"
          Some storeId ->
            match PriceStorage.getLatestPrice (UniversalBarcode code) (StoreId storeId) with
              None -> notFound.text "Price not found"
              Some (instant, record) ->
                json = Json.object [("recordedAt", Json.text (Instant.toText instant)), ("price", PriceRecord.toJson record)]
                ok.json json

  -- GET /prices/barcode/<code>/history?storeId=X - Get price history
  getPriceHistoryBarcode = do
    code = route GET (s "prices" / s "barcode" / Parser.text / s "history")
    storeIds = Route.request.queryParameter "storeId"
    match List.head storeIds with
      None -> badRequest.text "Missing storeId query parameter"
      Some storeIdText ->
        match Nat.fromText storeIdText with
          None -> badRequest.text "Invalid storeId, expected number"
          Some storeId ->
            history = PriceStorage.getPriceHistory (UniversalBarcode code) (StoreId storeId)
            entryToJson entry = match entry with (instant, record) -> Json.object [("recordedAt", Json.text (Instant.toText instant)), ("price", PriceRecord.toJson record)]
            ok.json (Json.array (List.map entryToJson history))

  -- GET /prices/barcode/<code>/compare - Compare across stores
  comparePricesBarcode = do
    code = route GET (s "prices" / s "barcode" / Parser.text / s "compare")
    prices = PriceStorage.getPricesAcrossStores (UniversalBarcode code)
    entryToJson entry = match entry with (StoreId sid, instant, record) -> Json.object [("storeId", Json.text (Nat.toText sid)), ("recordedAt", Json.text (Instant.toText instant)), ("price", PriceRecord.toJson record)]
    ok.json (Json.array (List.map entryToJson prices))

  -- GET /stores/<storeId>/prices - Get all prices at a store
  getStorePricesRoute = do
    storeIdText = route GET (s "stores" / Parser.text / s "prices")
    match Nat.fromText storeIdText with
      None -> badRequest.text "Invalid storeId, expected number"
      Some storeId ->
        prices = PriceStorage.getLatestPricesAtStore (StoreId storeId)
        entryToJson entry = match entry with (productId, instant, record) -> Json.object [("product", ProductIdentifier.toJson productId), ("recordedAt", Json.text (Instant.toText instant)), ("price", PriceRecord.toJson record)]
        ok.json (Json.array (List.map entryToJson prices))

  health <|> createPrice <|> getLatestPriceBarcode <|> getPriceHistoryBarcode <|> comparePricesBarcode <|> getStorePricesRoute

-- ============================================================
-- Main Entry Points
-- ============================================================

prices.main : Database -> HttpRequest ->{Exception, Storage, Remote, Log} HttpResponse
prices.main db req = PriceStorage.run db do Route.run prices.routes req

-- Add CORS headers
addCorsHeaders : HttpResponse -> HttpResponse
addCorsHeaders response =
  response
    |> HttpResponse.addHeader "Access-Control-Allow-Origin" "*"
    |> HttpResponse.addHeader "Access-Control-Allow-Methods" "GET, POST, PUT, DELETE, OPTIONS"
    |> HttpResponse.addHeader "Access-Control-Allow-Headers" "Content-Type, Authorization"

isOptionsMethod : HttpRequest -> Boolean
isOptionsMethod req =
  match HttpRequest.method req with
    OPTIONS -> true
    _ -> false

prices.mainWithCors : Database -> HttpRequest ->{Exception, Storage, Remote, Log} HttpResponse
prices.mainWithCors db req =
  if isOptionsMethod req then
    addCorsHeaders (HttpResponse.ok Body.empty)
  else addCorsHeaders (prices.main db req)

-- Local deployment
prices.deployLocal : '{IO, Exception} URI
prices.deployLocal = main.local.serve do
  env = Environment.default()
  db = Database.named "prices-db"
  Database.assign db env
  hash = deployHttp env (prices.mainWithCors db)
  name = ServiceName.named "prices-api"
  ServiceName.assign name hash

-- Cloud deployment
prices.deployCloud : '{IO, Exception} ServiceHash HttpRequest HttpResponse
prices.deployCloud = Cloud.main do
  env = Environment.default()
  db = Database.named "prices-db"
  Database.assign db env
  hash = deployHttp env (prices.mainWithCors db)
  name = ServiceName.named "prices-api"
  _ = ServiceName.assign name hash
  hash

