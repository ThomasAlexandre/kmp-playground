    , div [class "top-bar-buttons"] match maybeDisplayName with
        None ->
          [ a [href (base ++ "/login"), class "btn btn-secondary"] [text "Login"]
          , a [href (base ++ "/register"), class "btn btn-primary"] [text "Register"]
          ]
        Some name ->
          [ tapegram_html_2_0_0.span [] [text ("Hello, " ++ name)]
          , tapegram_html_2_0_0.button
              [ class "btn btn-secondary"
              , hx_post (base ++ "/logout")
              , tapegram_htmx_3_4_0.hx_swap
                  tapegram_htmx_3_4_0.hx_swap.AdjacentHtml.InnerHtml None
              , hx_target "body"
              ]
              [text "Logout"]
          ]
    ]

portal.appTileComponent2 :
  portal.AppTile -> Boolean -> tapegram_html_2_0_0.Html
portal.appTileComponent2 tile canEdit =
  use Text ++
  use tapegram_html_2_0_0 div text
  use tapegram_html_2_1_0.Attribute class
  base = portal.basePath
  tid = portal.AppTileId.toText (portal.AppTile.portalTileId tile)
  imgElem =
    tapegram_html_2_0_0.img
      [ tapegram_html_2_1_0.Attribute.src
          (portal.AppTile.portalTileImageUrl tile)
      , tapegram_html_2_1_0.Attribute.alt (portal.AppTile.portalTileName tile)
      ]
  nameElem =
    tapegram_html_2_0_0.span [] [text (portal.AppTile.portalTileName tile)]
  tileContent =
    tapegram_html_2_0_0.a
      [ tapegram_html_2_1_0.Attribute.href (portal.AppTile.portalTileUrl tile)
      , class "app-tile"
      , tapegram_html_2_1_0.Attribute.target "_blank"
      ]
      [imgElem, nameElem]
  deleteBtn =
    tapegram_html_2_0_0.button
      [ class "tile-delete"
      , hx_delete (base ++ "/apps/" ++ tid)
      , tapegram_htmx_3_4_0.hx_swap
          tapegram_htmx_3_4_0.hx_swap.AdjacentHtml.OuterHtml Optional.None
      , hx_target "closest .app-tile-wrapper"
      , tapegram_htmx_3_4_0.hx_confirm "Delete this app?"
      ]
      [text "x"]
  if canEdit then
    div
      [class "app-tile-wrapper"]
      [tileContent, div [class "tile-actions"] [deleteBtn]]
  else tileContent

