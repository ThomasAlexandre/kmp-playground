-- App Portal with Authentication
-- Extends the app-portal with a proper Auth ability for login/register
-- Uses session-based authentication with cookies and password hashing

type portal.auth.UserId
  = UserId Text

type portal.auth.User
  = { id : portal.auth.UserId,
      email : Text,
      hashedPassword : Text,
      displayName : Text }

type portal.auth.SessionId
  = SessionId Text

type portal.auth.Session
  = { sessionId : portal.auth.SessionId,
      userId : portal.auth.UserId,
      expiresAt : Instant }

ability portal.Auth where
  upsertUser : portal.auth.User ->{portal.Auth} ()
  getActiveSessionByToken :
    Text -> Instant ->{portal.Auth} Optional portal.auth.Session
  hashPassword : Text ->{portal.Auth} Text
  createSession :
    portal.auth.User -> Instant ->{portal.Auth} portal.auth.Session
  getUserById : portal.auth.UserId ->{portal.Auth} Optional portal.auth.User
  getUserByEmail : Text ->{portal.Auth} Optional portal.auth.User
  isPasswordValid : portal.auth.User -> Text ->{portal.Auth} Boolean
  deleteSession : portal.auth.SessionId ->{portal.Auth} ()

type portal.Auth.LoginFailure
  = UserNotFound
  | InvalidPassword

type portal.Auth.SignupFailure
  = InvalidEmail
  | UserAlreadyExists
  | PasswordTooShort Text

portal.auth.UserId.toText : portal.auth.UserId -> Text
portal.auth.UserId.toText = cases portal.auth.UserId.UserId id -> id

portal.auth.SessionId.toText : portal.auth.SessionId -> Text
portal.auth.SessionId.toText = cases portal.auth.SessionId.SessionId id -> id

portal.Auth.run :
  Database -> '{g, portal.Auth} a ->{g, Exception, Remote, Random} a
portal.Auth.run db p =
  use Bytes toHex
  use Instant + >
  use Optional None
  use OrderedTable named tryRead write
  use Text ==
  use Universal ordering
  use portal auth.Session
  use portal.auth User
  users : OrderedTable Text User
  users = named db "portal_auth_users" ordering
  usersByEmail : OrderedTable Text User
  usersByEmail = named db "portal_auth_users_by_email" ordering
  sessions : OrderedTable Text auth.Session
  sessions = named db "portal_auth_sessions" ordering
  upsertUser' : User ->{g, Remote} ()
  upsertUser' user =
    userId = portal.auth.UserId.toText (portal.auth.User.id user)
    write users userId user
    email = portal.auth.User.email user
    write usersByEmail email user
  getUserById' : portal.auth.UserId ->{g, Remote} Optional User
  getUserById' uid = tryRead users (portal.auth.UserId.toText uid)
  getUserByEmail' : Text ->{g, Remote} Optional User
  getUserByEmail' email = tryRead usersByEmail email
  getSessionByToken' : Text ->{g, Remote} Optional auth.Session
  getSessionByToken' token = tryRead sessions token
  upsertSession : auth.Session ->{g, Remote} ()
  upsertSession session =
    sessionToken =
      portal.auth.SessionId.toText (portal.auth.Session.sessionId session)
    write sessions sessionToken session
  deleteSession' : portal.auth.SessionId ->{g, Remote} ()
  deleteSession' sid =
    OrderedTable.delete sessions (portal.auth.SessionId.toText sid)
  saltAndHashPassword : Text -> Text
  saltAndHashPassword password =
    use Text ++
    salt = "portal-app-secure-salt-2026"
    hashBytes Sha2_256 (Text.toUtf8 (salt ++ password)) |> toHex
  go : Request {portal.Auth} a ->{g, Exception, Remote, Random} a
  go = cases
    { a } -> a
    { portal.Auth.upsertUser user -> resume } ->
      upsertUser' user
      handle resume() with go
    { portal.Auth.getUserById uid -> resume } ->
      result = getUserById' uid
      handle resume result with go
    { portal.Auth.getUserByEmail email -> resume } ->
      result = getUserByEmail' email
      handle resume result with go
    { portal.Auth.getActiveSessionByToken token now -> resume } ->
      result = getSessionByToken' token
      activeSession =
        match result with
          None -> None
          Some session ->
            if portal.auth.Session.expiresAt session > now then Some session
            else None
      handle resume activeSession with go
    { portal.Auth.createSession user now -> resume } ->
      sessionToken = toHex (Random.bytes 32)
      expiresAt = now + days +30
      session =
        portal.auth.Session.Session
          (portal.auth.SessionId.SessionId sessionToken)
          (portal.auth.User.id user)
          expiresAt
      upsertSession session
      handle resume session with go
    { portal.Auth.deleteSession sid -> resume } ->
      deleteSession' sid
      handle resume() with go
    { portal.Auth.isPasswordValid user password -> resume } ->
      isValid =
        portal.auth.User.hashedPassword user == saltAndHashPassword password
      handle resume isValid with go
    { portal.Auth.hashPassword rawPassword -> resume } ->
      hashed = saltAndHashPassword rawPassword
      handle resume hashed with go
  handle p() with go

portal.Auth.handleLogin :
  Text
  -> Text
  -> Instant
  ->{portal.Auth} Either portal.Auth.LoginFailure portal.auth.Session
portal.Auth.handleLogin email password now =
  user = portal.Auth.getUserByEmail email
  match user with
    Optional.None -> Left portal.Auth.LoginFailure.UserNotFound
    Some u        ->
      isValid = portal.Auth.isPasswordValid u password
      if isValid then
        session = portal.Auth.createSession u now
        Right session
      else Left portal.Auth.LoginFailure.InvalidPassword

portal.Auth.handleSignup :
  Text
  -> Text
  -> Text
  -> Instant
  ->{Random, portal.Auth} Either portal.Auth.SignupFailure portal.auth.Session
portal.Auth.handleSignup displayName email password now =
  use Nat <
  existingUser = portal.Auth.getUserByEmail email
  match existingUser with
    Some _ -> Left portal.Auth.SignupFailure.UserAlreadyExists
    Optional.None ->
      if Boolean.not (Text.contains "@" email) then
        Left portal.Auth.SignupFailure.InvalidEmail
      else
        if Text.size password < 8 then
          Left
            (portal.Auth.SignupFailure.PasswordTooShort
              "Password must be at least 8 characters")
        else
          hashedPassword = portal.Auth.hashPassword password
          userId = portal.auth.UserId.UserId (Bytes.toHex (Random.bytes 16))
          newUser =
            portal.auth.User.User userId email hashedPassword displayName
          portal.Auth.upsertUser newUser
          session = portal.Auth.createSession newUser now
          Right session

portal.Auth.getSessionFromCookie :
  Instant ->{Route, portal.Auth} Optional portal.auth.Session
portal.Auth.getSessionFromCookie now =
  use Optional None
  cookie = getCookie "portal_session"
  match cookie with
    None       -> None
    Some token -> portal.Auth.getActiveSessionByToken token now

portal.Auth.getCurrentUser :
  Instant ->{Route, portal.Auth} Optional portal.auth.User
portal.Auth.getCurrentUser now =
  match portal.Auth.getSessionFromCookie now with
    Optional.None -> Optional.None
    Some session ->
      portal.Auth.getUserById (portal.auth.Session.userId session)

portal.Auth.setSessionCookie : portal.auth.Session ->{Route} ()
portal.Auth.setSessionCookie session =
  use Text ++
  token = portal.auth.SessionId.toText (portal.auth.Session.sessionId session)
  cookieValue =
    "portal_session=" ++ token ++ "; Path=/; HttpOnly; SameSite=Lax"
  headers.add "Set-Cookie" cookieValue

portal.Auth.clearSessionCookie : '{Route} ()
portal.Auth.clearSessionCookie = do
  clearCookie = "portal_session=; Path=/; HttpOnly; Max-Age=0"
  headers.add "Set-Cookie" clearCookie

portal.basePath : Text
portal.basePath = "/s/app-portal"

portal.topBar3 : Optional portal.auth.User -> tapegram_html_2_0_0.Html
portal.topBar3 maybeUser =
  use Optional None
  use Text ++
  use tapegram_html_2_0_0 a div text span button
  use tapegram_html_2_1_0.Attribute class href style
  base = portal.basePath
  div
    [class "top-bar"]
    [ tapegram_html_2_0_0.h1 [] [text "App Portal"]
    , div [class "top-bar-buttons"] match maybeUser with
        None ->
          [ a [href (base ++ "/login"), class "btn btn-secondary"] [text "Login"]
          , a [href (base ++ "/register"), class "btn btn-primary"] [text "Register"]
          ]
        Some user ->
          [ span [] [text ("Hello, " ++ portal.auth.User.displayName user)]
          , button
              [ class "btn btn-secondary"
              , hx_post (base ++ "/logout")
              , tapegram_htmx_3_4_0.hx_swap tapegram_htmx_3_4_0.hx_swap.AdjacentHtml.InnerHtml None
              , hx_target "body"
              ]
              [text "Logout"]
          ]
    ]

portal.loginForm2 : Text -> Optional Text -> tapegram_html_2_0_0.Html
portal.loginForm2 emailValue errorMsg =
  use Optional None
  use Text ++
  use tapegram_html_2_0_0 div h2 form label input button p a text
  use tapegram_html_2_1_0.Attribute class type_ name value placeholder required style
  base = portal.basePath
  div
    [class "container"]
    [ h2 [] [text "Login"]
    , match errorMsg with
        Some msg -> div [class "error-msg"] [text msg]
        None -> text ""
    , form
        [ hx_post (base ++ "/login")
        , tapegram_htmx_3_4_0.hx_swap tapegram_htmx_3_4_0.hx_swap.AdjacentHtml.OuterHtml None
        ]
        [ div [class "form-group"]
            [ label [] [text "Email"]
            , input [type_ "email", name "email", value emailValue, placeholder "you@example.com", required true]
            ]
        , div [class "form-group"]
            [ label [] [text "Password"]
            , input [type_ "password", name "password", placeholder "Your password", required true]
            ]
        , button [type_ "submit", class "btn btn-primary", style "width: 100%"] [text "Login"]
        ]
    , p [style "text-align: center; margin-top: 1rem"]
        [ text "Don't have an account? "
        , a [tapegram_html_2_1_0.Attribute.href (base ++ "/register"), style "color: #e94560"] [text "Register"]
        ]
    ]

