-- Updated RecordPriceRequest with recordedAt field
type RecordPriceRequest
  = { product : ProductIdentifier
    , storeId : Nat
    , priceRecord : PriceRecord
    , recordedAt : Instant
    }

RecordPriceRequest.decoder : '{Decoder} RecordPriceRequest
RecordPriceRequest.decoder = do
  use Text ++
  use Decoder.object at!
  product = at! "product" ProductIdentifier.decoder
  storeIdText = at! "storeId" Decoder.text
  storeId = match Nat.fromText storeIdText with
    Some n -> n
    None -> Decoder.fail ("Invalid storeId, expected number: " ++ storeIdText)
  priceRecord = at! "price" PriceRecord.decoder
  recordedAtText = at! "recordedAt" Decoder.text
  recordedAt = match Instant.fromIso8601 recordedAtText with
    Some instant -> instant
    None -> Decoder.fail ("Invalid recordedAt, expected ISO8601 date: " ++ recordedAtText)
  RecordPriceRequest product storeId priceRecord recordedAt

-- Updated PriceStorage ability with Instant parameter
structural ability PriceStorage where
  recordPrice : ProductIdentifier -> StoreId -> Instant -> PriceRecord ->{PriceStorage} ()
  getLatestPrice : ProductIdentifier -> StoreId ->{PriceStorage} Optional (Instant, PriceRecord)
  getPriceHistory : ProductIdentifier -> StoreId ->{PriceStorage} [(Instant, PriceRecord)]
  getPricesAcrossStores : ProductIdentifier ->{PriceStorage} [(StoreId, Instant, PriceRecord)]
  getLatestPricesAtStore : StoreId ->{PriceStorage} [(ProductIdentifier, Instant, PriceRecord)]

-- Updated handler to use provided instant instead of Remote.now()
PriceStorage.run : Database -> '{g, PriceStorage} a ->{g, Remote} a
PriceStorage.run db computation =
  use OrderedTable named rangeClosed write
  use Stream toList
  use Universal ordering
  productIndex = named db "prices_by_product" ordering
  storeIndex = named db "prices_by_store" ordering
  go : Request {PriceStorage} a ->{g, Remote} a
  go = cases
    { a } -> a
    { recordPrice productId storeId instant record -> resume } ->
      primaryKey = (productId, storeId, instant)
      secondaryKey = (storeId, productId, instant)
      write productIndex primaryKey record
      write storeIndex secondaryKey record
      handle resume() with go
    { getLatestPrice productId storeId -> resume } ->
      startKey = (productId, storeId, epoch)
      endKey = (productId, storeId, farFuture)
      entries = toList (rangeClosed productIndex startKey endKey)
      result = match List.last entries with
        None -> None
        Some ((_, _, instant), record) -> Some (instant, record)
      handle resume result with go
    { getPriceHistory productId storeId -> resume } ->
      startKey = (productId, storeId, epoch)
      endKey = (productId, storeId, farFuture)
      entries = toList (rangeClosed productIndex startKey endKey)
      extractEntry = cases ((_, _, instant), record) -> (instant, record)
      history = List.reverse (List.map extractEntry entries)
      handle resume history with go
    { getPricesAcrossStores productId -> resume } ->
      startKey = (productId, StoreId 0, epoch)
      endKey = (productId, StoreId maxNat, farFuture)
      allEntries = toList (rangeClosed productIndex startKey endKey)
      latestByStore = groupLatestByStore allEntries
      handle resume latestByStore with go
    { getLatestPricesAtStore storeId -> resume } ->
      startKey = (storeId, UniversalBarcode "", epoch)
      endKey = (storeId, UniversalBarcode "~", farFuture)
      allEntries = toList (rangeClosed storeIndex startKey endKey)
      latestByProduct = groupLatestByProduct allEntries
      handle resume latestByProduct with go
  handle computation() with go

-- Updated routes to pass recordedAt from request
prices.routes : '{Route, PriceStorage, Exception, Log} ()
prices.routes =
  use Json array object
  use List head map
  use Parser /
  use Route <|>
  health = do
    noCapture GET (s "health")
    ok.text "ok"
  createPrice = do
    noCapture POST (s "prices")
    request = decodeJson RecordPriceRequest.decoder
    info "Recording price" [("storeId", Nat.toText (RecordPriceRequest.storeId request)), ("recordedAt", Instant.toText (RecordPriceRequest.recordedAt request))]
    recordPrice
      (RecordPriceRequest.product request)
      (StoreId (RecordPriceRequest.storeId request))
      (RecordPriceRequest.recordedAt request)
      (RecordPriceRequest.priceRecord request)
    setStatus (Status 201 "Created")
    ok.json (object [("status", Json.text "created")])
  getLatestPriceBarcode = do
    code = route GET (s "prices" / s "barcode" / Parser.text)
    storeIds = queryParameter "storeId"
    match head storeIds with
      None -> badRequest.text "Missing storeId query parameter"
      Some storeIdText ->
        match parseStoreId storeIdText with
          None -> badRequest.text "Invalid storeId, expected number"
          Some storeId ->
            match getLatestPrice (UniversalBarcode code) storeId with
              None -> notFound.text "Price not found"
              Some (instant, record) ->
                json = object [("recordedAt", Json.text (Instant.toText instant)), ("price", PriceRecord.toJson record)]
                ok.json json
  getPriceHistoryBarcode = do
    code = route GET (s "prices" / s "barcode" / Parser.text / s "history")
    storeIds = queryParameter "storeId"
    match head storeIds with
      None -> badRequest.text "Missing storeId query parameter"
      Some storeIdText ->
        match parseStoreId storeIdText with
          None -> badRequest.text "Invalid storeId, expected number"
          Some storeId ->
            history = getPriceHistory (UniversalBarcode code) storeId
            entryToJson = cases (instant, record) -> object [("recordedAt", Json.text (Instant.toText instant)), ("price", PriceRecord.toJson record)]
            ok.json (array (map entryToJson history))
  comparePricesBarcode = do
    code = route GET (s "prices" / s "barcode" / Parser.text / s "compare")
    prices = getPricesAcrossStores (UniversalBarcode code)
    entryToJson = cases (StoreId sid, instant, record) -> object [("storeId", Json.text (Nat.toText sid)), ("recordedAt", Json.text (Instant.toText instant)), ("price", PriceRecord.toJson record)]
    ok.json (array (map entryToJson prices))
  getStorePricesRoute = do
    storeIdText = route GET (s "stores" / Parser.text / s "prices")
    match parseStoreId storeIdText with
      None -> badRequest.text "Invalid storeId, expected number"
      Some storeId ->
        prices = getLatestPricesAtStore storeId
        entryToJson = cases (productId, instant, record) -> object [("product", ProductIdentifier.toJson productId), ("recordedAt", Json.text (Instant.toText instant)), ("price", PriceRecord.toJson record)]
        ok.json (array (map entryToJson prices))
  health <|> createPrice <|> getPriceHistoryBarcode <|> comparePricesBarcode <|> getLatestPriceBarcode <|> getStorePricesRoute

-- Main entry point (unchanged signature but uses updated ability)
prices.main : Database -> HttpRequest ->{Exception, Storage, Remote, Log} HttpResponse
prices.main db req = PriceStorage.run db do Route.run prices.routes req
