portal.appGrid2 : [portal.AppTile] -> Boolean -> tapegram_html_2_0_0.Html
portal.appGrid2 tiles canEdit =
  use List :+
  tileElements = List.map (tile -> portal.appTileComponent2 tile canEdit) tiles
  gridContent = if canEdit then tileElements :+ portal.addTileButton2 else tileElements
  tapegram_html_2_0_0.div
    [tapegram_html_2_1_0.Attribute.class "app-grid"] gridContent

portal.main2 :
  Database
  -> HttpRequest
  ->{Exception, Storage, Remote, Random, Log} HttpResponse
portal.main2 db req =
  portal.Auth.run db do
    portal.AppTileStorage.run db do
      Route.run (portal.auth.routes Route.<|> portal.app.routes) req

portal.deployLocal2 : '{IO, Exception} URI
portal.deployLocal2 = main.local.serve do
  use portal appName
  env = Environment.default()
  db = Database.named appName
  Database.assign db env
  hash = deployHttp env (portal.main2 db)
  name = ServiceName.named appName
  ServiceName.assign name hash